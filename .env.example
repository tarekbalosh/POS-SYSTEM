# ==============================================================================
# PROPOS SAAS ENVIRONMENT CONFIGURATION
# ==============================================================================

# ── APP SETTINGS ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ── DATABASE (PostgreSQL) ────────────────────────────────────────────────────
# For production (Neon/RDS): postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_saas?schema=public"

# ── CACHE & QUEUE (Redis) ───────────────────────────────────────────────────
# Use rediss:// (with double 's') for TLS connections (Upstash/AWS)
REDIS_URL="redis://localhost:6379"

# ── AUTHENTICATION ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=your_ultra_secure_jwt_secret_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_ultra_secure_refresh_secret_here
REFRESH_TOKEN_EXPIRES_IN=7d

# NextAuth (Frontend)
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── STORAGE (Cloudflare R2 / S3) ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pos-assets
R2_PUBLIC_URL=https://pub-yourid.r2.dev

# ── MONITORING ──────────────────────────────────────────────────────────────
SENTRY_DSN=
SLACK_WEBHOOK_URL=

# ── EXTERNAL INTEGRATIONS ──────────────────────────────────────────────────
# Quickbooks / Xero
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:3001/accounting/callback/qb
