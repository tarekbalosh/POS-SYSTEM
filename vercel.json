{
  "version": 2,
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "apps/api/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/apps/api/api" },
    { "source": "/manifest.json", "destination": "/apps/web/manifest.json" },
    { "source": "/icon-:path*", "destination": "/apps/web/icon-:path*" },
    { "source": "/images/:path*", "destination": "/apps/web/images/:path*" },
    { "source": "/sw-:path*", "destination": "/apps/web/sw-:path*" },
    { "source": "/(.*)", "destination": "/apps/web/$1" }
  ]
}
