{
  "name": "pos-saas",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "postinstall": "npx prisma@6.4.1 generate --schema=packages/database/schema.prisma",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test:e2e": "echo \"E2E tests skipped\" && exit 0",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@prisma/client": "^6.4.1",
    "prettier": "^3.0.0",
    "prisma": "^6.4.1",
    "turbo": "latest"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "lightningcss": "1.28.2"
  },
  "packageManager": "npm@10.2.4"
}
